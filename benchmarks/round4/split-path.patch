     mov     %1, %2
-    shl     %1, 7                       ; PATH_SIZE
+    shl     %1, PATH_SHIFT                       ; PATH_SIZE
     add     %1, [paths]
 %endmacro

@@ -126,6 +129,7 @@ path_new:
