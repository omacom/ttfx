--- i/asm/ttfx.inc
+++ w/asm/ttfx.inc
@@ -234,27 +234,29 @@ global %1
 %define FR_DURATION         4           ; u32 ticks

 ; path record (PATH_SIZE bytes; index into [paths])
-%define PATH_SIZE           128
-%define PA_NAME             0           ; u32
-%define PA_NEXT             4           ; i32 next path of the same character
-%define PA_SPEED            8           ; f64
-%define PA_EASE             16          ; i32 easing id or NONE
-%define PA_LAYER            20          ; i32 (PAF_LAYER)
-%define PA_FLAGS            24          ; u32 PAF_*
-%define PA_OWNER            28          ; u32 character slot
-%define PA_HOLD             32          ; i64 hold_time
-%define PA_HOLD_LEFT        40          ; i64 hold_time_remaining
-%define PA_TOTAL            48          ; f64 total_distance
-%define PA_STEP             56          ; i64 current_step
-%define PA_MAX              64          ; i64 max_steps
-%define PA_LAST             72          ; f64 last_distance_reached
-%define PA_ORIGIN_DIST      80          ; f64 origin segment distance (PAF_ORIGIN)
-%define PA_SEGS             88          ; u64 pointer to segments
-%define PA_SEG_COUNT        96          ; u32
-%define PA_SEG_CAP          100         ; u32
-%define PA_WPS              104         ; u64 pointer to waypoints
-%define PA_WP_COUNT         112         ; u32
-%define PA_WP_CAP           116         ; u32
+%define PATH_SIZE           64
+%define PATH_SHIFT          6
+%define PATH_COLD           ((1 << 24) * PATH_SIZE + 2080)
+%define PA_NAME             (PATH_COLD + 0)           ; u32
+%define PA_NEXT             (PATH_COLD + 4)           ; i32 next path of the same character
+%define PA_SPEED            (PATH_COLD + 8)           ; f64
+%define PA_EASE             52          ; i32 easing id or NONE
+%define PA_LAYER            (PATH_COLD + 16)          ; i32 (PAF_LAYER)
+%define PA_FLAGS            (PATH_COLD + 20)          ; u32 PAF_*
+%define PA_OWNER            48          ; u32 character slot
+%define PA_HOLD             (PATH_COLD + 24)          ; i64 hold_time
+%define PA_HOLD_LEFT        (PATH_COLD + 32)          ; i64 hold_time_remaining
+%define PA_TOTAL            0          ; f64 total_distance
+%define PA_STEP             8          ; i64 current_step
+%define PA_MAX              16          ; i64 max_steps
+%define PA_LAST             24          ; f64 last_distance_reached
+%define PA_ORIGIN_DIST      (PATH_COLD + 40)          ; f64 origin segment distance (PAF_ORIGIN)
+%define PA_SEGS             32          ; u64 pointer to segments
+%define PA_SEG_COUNT        40          ; u32
+%define PA_SEG_CAP          44         ; u32
+%define PA_WPS              (PATH_COLD + 48)         ; u64 pointer to waypoints
+%define PA_WP_COUNT         (PATH_COLD + 56)         ; u32
+%define PA_WP_CAP           (PATH_COLD + 60)         ; u32

 %define PAF_LAYER           1
 %define PAF_LOOP            2
